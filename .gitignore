# Flutter/Dart/Pub related
# API documentation (generated by dartdoc)
# **/doc/api/  ← desactivado: la documentación dartdoc sí se publica
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ==========================================
# Archivos de Seguridad y Credenciales (NO PUBLICAR)
# ==========================================

# Firebase Auth / Configs
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Keystores y claves de firma
*.jks
*.keystore
android/key.properties
key.properties

# Archivos de entorno y configuraciones locales
.env
.env.*
*.local
local.properties

# Node/Firebase functions
functions/node_modules/
functions/lib/
functions/.env

# Firebase CLI cache
.firebase/

# Builds y releases — solo se ignoran los artefactos de debug y metadatos
# (los binarios de release sí se publican, ver releases/.gitignore)

# ==========================================
# Fastlane - Automatización de Stores
# ==========================================

# Directorio completo (no requerido para replicar/evaluar el proyecto)
/fastlane/

