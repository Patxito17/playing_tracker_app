rules_version = '2';

// ============================================================================
// Reglas de Seguridad de Firestore - Playing Tracker
// ============================================================================
//
// Sprint 7 - Fase 4 - Seguridad: Validaciones espejo de campo añadidas.
//
// Cambios respecto a la versión anterior:
//  - isTeacher(): Usa request.auth.token.role == 'teacher' (sin lectura extra).
//  - isStudent(): Usa request.auth.token.role == 'student' (sin lectura extra).
//  - teachers/students: Lectura restringida al propietario del perfil (privacidad).
//  - [NUEVO Sprint 7 Fase 4] Funciones helper isValidName() e isValidTitle() para
//    validar longitudes máximas de campos de texto directamente en las reglas,
//    previniendo bypasses vía REST API o accesos directos al SDK.
//
// Principios de seguridad:
// - Denegar por defecto, permitir explícitamente
// - Todos los permisos requieren autenticación
// - Validación de roles mediante Custom Claims en el token JWT (sin coste extra)
// - Separación granular de permisos (create/read/update/delete)
// - Inmutabilidad de sesiones (no update/delete)
// - Validación de longitud máxima de campos para integridad de datos
//
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // FUNCIONES HELPER
    // ==========================================================================

    /// Verifica si el usuario está autenticado
    function isAuth() {
      return request.auth != null;
    }

    /// Verifica si el usuario es el propietario del documento
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    /// Verifica si el usuario autenticado es un docente.
    /// Prioridad 1: Custom Claim (sin lectura extra).
    /// Prioridad 2: Fallback leyendo la colección `teachers`.
    function isTeacher() {
      let isAuthValid = isAuth();
      let hasClaim = isAuthValid && 'role' in request.auth.token && request.auth.token.role == 'teacher';
      let hasDbRole = isAuthValid && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
      return isAuthValid && (hasClaim || hasDbRole);
    }

    /// Verifica si el usuario autenticado es un alumno.
    /// Prioridad 1: Custom Claim (sin lectura extra).
    /// Prioridad 2: Fallback leyendo la colección `students`.
    function isStudent() {
      let isAuthValid = isAuth();
      let hasClaim = isAuthValid && 'role' in request.auth.token && request.auth.token.role == 'student';
      let hasDbRole = isAuthValid && exists(/databases/$(database)/documents/students/$(request.auth.uid));
      return isAuthValid && (hasClaim || hasDbRole);
    }

    /// Verifica si el usuario es el creador de la clase
    function isClassOwner(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isAuth() && classData.ownerTeacherId == request.auth.uid;
    }

    /// Valida que un campo de nombre de persona (firstName, lastName) sea válido.
    /// Máximo 60 caracteres, mínimo 2 caracteres y no vacío.
    function isValidName(value) {
      return value is string && value.size() >= 2 && value.size() <= 60;
    }

    /// Valida que un título de clase o tarea sea válido.
    /// Máximo 100 caracteres, mínimo 2 caracteres (permite títulos cortos).
    function isValidTitle(value) {
      return value is string && value.size() >= 2 && value.size() <= 100;
    }

    /// Valida que una descripción sea válida (campo opcional).
    /// Máximo 500 caracteres.
    function isValidDescription(value) {
      return !(value is string) || value.size() <= 500;
    }

    // ==========================================================================
    // COLECCIÓN: teachers
    // ==========================================================================
    // Perfiles de docentes
    // - Read: Solo el propio docente (ACTUALIZADO: antes era cualquier usuario autenticado)
    // - Write: Solo el propio docente
    // - IDs: UID de Firebase Authentication

    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isTeacher();
      // Validación de longitud máxima en campos de texto al crear perfil
      allow create: if isOwner(teacherId) &&
                      isValidName(request.resource.data.firstName) &&
                      isValidName(request.resource.data.lastName);
      allow update: if isOwner(teacherId);
      allow delete: if isOwner(teacherId);
    }

    // ==========================================================================
    // COLECCIÓN: students
    // ==========================================================================
    // Perfiles de alumnos con agregados denormalizados
    // - Read: Solo el propio alumno o el docente de su clase (ACTUALIZADO)
    // - Write: Solo el propio alumno
    // - IDs: UID de Firebase Authentication

    match /students/{studentId} {
      allow read: if isOwner(studentId) || isTeacher();
      // Validación de longitud máxima en campos de texto al crear perfil
      allow create: if isOwner(studentId) &&
                      isValidName(request.resource.data.firstName) &&
                      isValidName(request.resource.data.lastName);
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
    }

    // ==========================================================================
    // COLECCIÓN: classes
    // ==========================================================================
    // Definiciones de clases/grupos
    // - Read: Cualquier usuario autenticado
    // - Create: Solo docentes (validado con Custom Claim)
    // - Update/Delete: Solo el docente propietario (ownerTeacherId)

    match /classes/{classId} {
      allow read: if isAuth();

      // Solo teachers pueden crear clases
      allow create: if isTeacher() &&
                      request.resource.data.ownerTeacherId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['id', 'name', 'ownerTeacherId', 'accessCode', 'createdAt', 'updatedAt', 'isActive']) &&
                      // Validación de longitud máxima (espejo del cliente)
                      isValidTitle(request.resource.data.name) &&
                      isValidDescription(request.resource.data.get('description', null));

      // Solo el owner puede actualizar o eliminar
      allow update: if isAuth() && resource.data.ownerTeacherId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerTeacherId == request.auth.uid;
    }

    // ==========================================================================
    // COLECCIÓN: memberships
    // ==========================================================================
    // Relación N:M entre alumnos y clases
    // - Read: Alumno o docente relacionados
    // - Create: Solo el docente relacionado
    // - Update/Delete: Solo el docente relacionado

    match /memberships/{membershipId} {
      // Lectura: alumno involucrado o teacher relacionado
      allow read: if isAuth() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isClassOwner(resource.data.classId)
      );

      // Creación: teacher propietario o alumno autenticado (código de acceso)
      allow create: if isAuth() &&
                      (
                        (isTeacher() && request.resource.data.teacherId == request.auth.uid) ||
                        request.resource.data.studentId == request.auth.uid
                      ) &&
                      request.resource.data.keys().hasAll(['id', 'classId', 'studentId', 'teacherId', 'className', 'joinedAt', 'updatedAt', 'isActive']);

      // Actualización: Teacher relacionado O Student propietario (solo campos de perfil)
      allow update: if isAuth() && (
        resource.data.teacherId == request.auth.uid ||
        (
          resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName', 'studentEmail', 'updatedAt'])
        )
      );

      // Eliminación: solo el teacher relacionado o dueño de la clase
      allow delete: if isAuth() && (
        resource.data.teacherId == request.auth.uid ||
        isClassOwner(resource.data.classId)
      );
    }

    // ==========================================================================
    // COLECCIÓN: tasks
    // ==========================================================================
    // Definiciones maestras de tareas
    // - Read: Cualquier usuario autenticado
    // - Create: Solo docentes (validado con Custom Claim)
    // - Update/Delete: Solo el docente creador (createdBy)

    match /tasks/{taskId} {
      allow read: if isAuth();

      // Solo teachers pueden crear tareas
      allow create: if isTeacher() &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.keys().hasAll(['id', 'title', 'createdBy', 'durationSuggested', 'createdAt', 'updatedAt', 'isActive']) &&
                      // Validación de longitud máxima (espejo del cliente)
                      isValidTitle(request.resource.data.title) &&
                      isValidDescription(request.resource.data.get('description', null));

      // Solo el creador puede actualizar o eliminar
      allow update: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ==========================================================================
    // COLECCIÓN: assignments
    // ==========================================================================
    // Asignaciones individuales tarea-alumno con progreso
    // - Read: Alumno asignado o docente relacionado
    // - Create: Solo el docente relacionado
    // - Update: Docente relacionado o alumno (para actualizar progreso)
    // - Delete: Solo el docente relacionado

    match /assignments/{assignmentId} {
      // Lectura: alumno para su propia tarea, o cualquier docente para gestión
      allow read: if isAuth() && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isTeacher()
      );

      // Creación: Solo el docente autenticado puede crear asignaciones para sí mismo
      allow create: if isAuth() && isTeacher() &&
                      request.resource.data.teacherId == request.auth.uid;

      // Actualización: El docente propietario o el alumno asignado (para progreso)
      allow update: if isAuth() && (
        (resource != null && resource.data.teacherId == request.auth.uid) ||
        (resource != null && resource.data.studentId == request.auth.uid)
      );

      // Eliminación: Solo el docente propietario o el dueño de la clase asociada
      allow delete: if isAuth() && resource != null && (
        resource.data.teacherId == request.auth.uid ||
        isClassOwner(resource.data.classId)
      );
    }

    // ==========================================================================
    // COLECCIÓN: sessions
    // ==========================================================================
    // Registros atómicos de sesiones de estudio (INMUTABLES)
    // - Create: Solo el alumno propietario (validado con Custom Claim)
    // - Read: Alumno propietario o docente relacionado
    // - Update/Delete: NO PERMITIDO (inmutabilidad para integridad histórica)

    match /sessions/{sessionId} {
      // Creación: solo students pueden crear sesiones propias
      allow create: if isStudent() &&
                      request.resource.data.studentId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['id', 'studentId', 'taskId', 'teacherId', 'startTime', 'endTime', 'totalDuration', 'pausedDuration', 'dateLogged', 'monthBucket', 'createdAt']);

      // Lectura: student propietario o teacher relacionado
      allow read: if isAuth() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );

      // Inmutabilidad: NO permitir actualizaciones ni eliminaciones
      allow update, delete: if false;
    }
  }
}
